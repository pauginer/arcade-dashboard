# Postgres connection string (Neon, Vercel Postgres, or any Postgres instance).
DATABASE_URL=postgresql://user:password@localhost:5432/arcade_dashboard

# Required for image uploads via /admin. Get this by connecting a Blob store
# to your Vercel project (Storage tab) and running `vercel env pull`, or from
# the Vercel dashboard directly.
BLOB_READ_WRITE_TOKEN=

# Optional: pin QR codes to a specific origin instead of the request's host header.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
